DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-discord-application-id
MONGO_URI=mongodb://localhost:27017/key-drop
PREFIX=!

# Optional AI support for database uploads
OPENAI_API_KEY=



# Optional admin dashboard. Register this exact callback URL in the Discord
# Developer Portal under OAuth2 > Redirects.
DISCORD_CLIENT_SECRET=your-discord-client-secret
DASHBOARD_REDIRECT_URI=https://symmetrical-chainsaw-69jrqrp75wrgh4q5j-3000.app.github.dev/auth/callback
DASHBOARD_PORT=3000
# Hosting platforms set PORT automatically; it takes precedence over DASHBOARD_PORT.
# Use 0.0.0.0 so Codespaces and hosting platforms can expose the web port.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_COOKIE_SECURE=false
